# ---------------------------------------------------------------------------
# NYX environment configuration (copy to .env and adjust; never commit .env)
# ---------------------------------------------------------------------------

# ---- Backend -------------------------------------------------------------
# Path of the SQLite database. Relative paths resolve against the repo root.
# In Docker Compose this is pointed at the mounted volume.
NYX_DB_PATH=backend/data/nyx.sqlite3

# development | production (controls uvicorn autoreload when run via app.main)
NYX_ENV=development
NYX_LOG_LEVEL=INFO

# Comma-separated origins allowed to call the API (Vite dev servers by default).
NYX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Create three clearly-labelled example projects on first start (1|0).
NYX_SEED_EXAMPLES=1

# Optional: serve the built frontend from the backend container (single-image mode).
# NYX_STATIC_DIR=frontend/dist

# ---- Optional AI provider (OpenAI-compatible) ----------------------------
# NYX is fully functional with NONE of these set: it then uses its deterministic
# rules engine and clearly labels the analysis as rule-based.
#
# Any OpenAI-compatible /chat/completions endpoint works.
NYX_AI_ENABLED=1
NYX_AI_BASE_URL=
# Never commit a real key. Leave empty to run without AI assistance.
NYX_AI_API_KEY=
NYX_AI_MODEL=
# Guard rails: bounded timeouts, bounded retries, bounded tokens, optional throttle.
NYX_AI_TIMEOUT_S=12
NYX_AI_MAX_RETRIES=1
NYX_AI_MAX_TOKENS=1200
NYX_AI_TEMPERATURE=0
NYX_AI_MIN_INTERVAL_MS=0
NYX_AI_CACHE_TTL_S=900
NYX_AI_CACHE_MAX_ENTRIES=128

# ---- Frontend (build/runtime) --------------------------------------------
# Leave empty for same-origin (recommended: the dev server and nginx both proxy /api).
VITE_API_BASE_URL=
