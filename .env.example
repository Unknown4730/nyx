# ---------------------------------------------------------------------------
# NYX environment configuration: a reference, not a secret store.
#
# NYX works with NO changes to this file. The backend reads these variables from
# its process environment (it does not parse this file). On Windows PowerShell,
# set a variable for the current window with:
#     $env:NYX_LOG_LEVEL = "DEBUG"
# Never commit a real .env file or a real API key (.env is git-ignored).
# ---------------------------------------------------------------------------

# ---- Backend ---------------------------------------------------------------
# SQLite database for saved projects. Relative paths resolve against the repo root.
NYX_DB_PATH=backend/data/nyx.sqlite3

# development | production
NYX_ENV=development
NYX_LOG_LEVEL=INFO

# Comma-separated origins allowed to call the API directly. The Vite dev server
# proxies /api, so the browser normally never needs this.
NYX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Create three clearly labelled example projects on first start (1 or 0).
NYX_SEED_EXAMPLES=1

# Serve a built client from the backend (single-process mode). Build it first with
# `npm run build` in frontend/. Leave unset during development.
# NYX_STATIC_DIR=frontend/dist

# ---- Optional AI assist (OpenAI-compatible endpoint) ----------------------
# With none of these set, NYX runs entirely on its deterministic rules engine and
# labels every result accordingly. AI can only propose requirement values; scoring,
# mapping, cost, security and migration stay rule-based.
NYX_AI_ENABLED=1
NYX_AI_BASE_URL=
NYX_AI_API_KEY=
NYX_AI_MODEL=
# Guard rails: bounded timeouts, retries, tokens and cache.
NYX_AI_TIMEOUT_S=12
NYX_AI_MAX_RETRIES=1
NYX_AI_MAX_TOKENS=1200
NYX_AI_TEMPERATURE=0
NYX_AI_MIN_INTERVAL_MS=0
NYX_AI_CACHE_TTL_S=900
NYX_AI_CACHE_MAX_ENTRIES=128

# ---- Frontend --------------------------------------------------------------
# Leave empty: the browser always calls /api on the same origin. Set only if the
# API is served from a different origin at build time.
VITE_API_BASE_URL=
# Where the Vite dev server forwards /api (server-side; default is the local API).
# NYX_API_PROXY=http://127.0.0.1:8000
